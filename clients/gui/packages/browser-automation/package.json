{
  "name": "@areal/browser-automation",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.cjs"
    },
    "./electron": {
      "types": "./src/electron.ts",
      "default": "./dist/electron.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE-ZCODE",
    "NOTICE",
    "UPSTREAM.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "acceptance": "node acceptance/run.mjs",
    "acceptance:profile": "node acceptance/shared-profile-run.mjs"
  },
  "dependencies": {
    "playwright-core": "1.59.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "electron": "44.9.3"
  }
}
