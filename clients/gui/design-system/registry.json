      "states": [
        "loading",
        "empty",
        "ready",
        "failed",
        "unknown"
      ],
      "variation": "状态说明、必要详情及可行恢复入口",
      "acceptance": "离线/失败/未知区分，静默刷新保留已确认内容"
    }
