  "patterns": [
    {
      "id": "P-SETTINGS",
      "intent": "修改偏好或配置",
      "components": [
        "SettingsPage",
        "SettingsSection",
        "SettingsGroupCard",
        "SettingsRow"
      ],
      "reference": "renderer/src/settings/DisplaySettings.tsx",
      "slots": [
        "label",
        "control",
        "detail"
      ],
      "states": [
        "default",
        "busy",
        "failed",
        "unknown",
        "disabled"
      ],
      "variation": "分组、字段、文案与现有控件类型",
      "acceptance": "标签/控件对齐，窄窗换行，值和反馈真实"
    },
    {
      "id": "P-RESOURCES",
      "intent": "查找并管理资源",
      "components": [
        "SettingsSection",
        "ActionButton",
        "Feedback"
      ],
      "reference": "renderer/src/settings/PluginCenter.tsx",
      "slots": [
        "toolbar",
        "list",
        "detail"
      ],
      "states": [
        "loading",
        "empty",
        "ready",
        "failed"
      ],
      "variation": "搜索、筛选、资源状态与详情",
      "acceptance": "安装/连接状态分开；列表和详情职责清楚"
    },
    {
      "id": "P-CONVERSATION",
      "intent": "阅读并推进任务",
      "components": [
        "Messages",
        "TurnProgress",
        "TurnExecution",
        "ToolEvent",
        "ConversationComposer",
        "CommandDetails",
        "AgentConversationPane",
        "SentAttachment"
      ],
      "reference": "renderer/src/design-system/ConversationFlowExercise.tsx",
      "slots": [
        "timeline",
        "composer",
        "context"
      ],
      "states": [
        "ready",
        "busy",
        "failed",
        "unknown",
        "reading-history",
        "following-latest",
        "tool-details",
        "completed",
        "command-streaming",
        "parallel-working",
        "image-preview",
        "child-conversation"
      ],
      "variation": "消息类型、工具结果、合法动作与上下文",
      "acceptance": "权威状态、内容层级与阅读意图独立；按信息流合同验收完成收敛、人工展开和返回最新；未知提交不重放",
      "ruleSource": "design-system/patterns.md",
      "rules": [
        "CONV-OWNER-01",
        "CONV-INPUT-01",
        "CONV-CONTENT-01",
        "CONV-GROUP-01",
        "CONV-DISCLOSURE-01",
        "CONV-READ-01",
        "CONV-RESOURCE-01",
        "CONV-COMMAND-01",
        "CONV-PARALLEL-01",
        "CONV-SCENARIO-01"
      ]
    },
    {
      "id": "P-DECISION",
