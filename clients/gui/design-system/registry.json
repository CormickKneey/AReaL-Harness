      "components": [
        "DecisionCard",
        "ApprovalRequest",
        "Feedback"
      ],
      "reference": "renderer/src/ApprovalRequest.tsx",
      "slots": [
        "request",
        "actions",
        "feedback"
      ],
      "states": [
        "ready",
        "busy",
        "failed",
        "unknown"
      ],
      "variation": "请求正文及已有决策动作",
      "acceptance": "关键参数可核对，动作和结果可达"
    },
    {
      "id": "P-DETAIL",
      "intent": "阅读或编辑详情",
      "components": [
        "SettingsDialog",
        "SettingsDisclosure",
        "Feedback"
      ],
      "reference": "renderer/src/settings/common.tsx",
      "slots": [
        "body",
        "actions"
      ],
      "states": [
        "ready",
        "busy",
        "failed"
      ],
      "variation": "表单字段、正文及受控 footer",
      "acceptance": "返回/关闭路径和焦点恢复；不叠多层弹窗"
    },
    {
      "id": "P-STATUS",
      "intent": "了解状态并恢复",
      "components": [
        "Feedback",
        "EmptySettings"
      ],
      "reference": "renderer/src/settings/ServiceStatusSettings.tsx",
      "slots": [
        "status",
        "recovery"
